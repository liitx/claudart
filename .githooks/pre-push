#!/usr/bin/env bash
# pre-push — paradigm + correctness gate before pushing to a shared remote.
#
# Tracked in the repo (.githooks/, not .git/hooks/) so it travels with a
# fresh clone — .git/hooks/ is local-only and never committed, which is
# exactly why this protection didn't exist here before. Activate once per
# clone with: git config core.hooksPath .githooks
#
# Mirrors zedup's own pre-push pattern (confirm, then gate), extended with
# analyze/custom_lint/the duplicate-literal check — commits stay fast and
# ungated; this is where the expensive, full checks belong instead.

set -uo pipefail

# A push from a linked worktree arrives with GIT_DIR/GIT_WORK_TREE/
# GIT_INDEX_FILE set by git itself, pointed at that worktree's own
# .git/worktrees/<name> — confirmed real: left set, every `git` call this
# hook or the test suite's own subprocesses make (test/helpers/cli_session.dart
# included) can silently redirect into the real repo instead of a fresh temp
# one. Unset before anything else runs.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

REPO="$(git rev-parse --show-toplevel)"
cd "$REPO"

BOLD="\033[1m"
RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
RESET="\033[0m"

# A pure branch-deletion push (`git push origin --delete <branch>`) reports
# an all-zero local oid for every ref — nothing new is being pushed, so the
# full gate is pure waste. Confirmed real: deleting 5 merged branches ran
# the complete suite 5 times over, for zero new code.
ZERO_OID="0000000000000000000000000000000000000000"
ALL_DELETES=true
while read -r _local_ref local_oid _remote_ref _remote_oid; do
  [[ "$local_oid" == "$ZERO_OID" ]] || ALL_DELETES=false
done
if [[ "$ALL_DELETES" == true ]]; then
  echo "Deleting a remote ref only — skipping the gate."
  exit 0
fi

# Not `[ -t 0 ] && ...` — git always pipes stdin to a pre-push hook (the
# ref-update lines), so stdin is never a terminal even when the invoking
# shell has a real one. That made this confirmation dead code, confirmed
# under a pseudo-terminal: the prompt never appeared. Open /dev/tty
# directly instead and let its own success/failure be the only signal.
# `read -p` writes its prompt to stdout, not to fd 3 — confirmed real:
# when stdout isn't the visible terminal (captured/piped by whatever ran
# `git push`), the prompt never appears anywhere, but `read` still blocks
# on the real tty waiting for input. Looks hung until someone blindly
# types an answer. Print to fd 3 explicitly instead of trusting `-p`.
if exec 3<>/dev/tty 2>/dev/null; then
  printf "Push to remote? [y/N]: " >&3
  read -r confirm <&3
  exec 3>&-
  [[ "$confirm" =~ ^[Yy]$ ]] || { echo "Push cancelled."; exit 1; }
fi

FAILED=0

echo ""
echo -e "${BOLD}dart analyze${RESET}"
# dart analyze's own exit code goes nonzero on info-level hints too (19
# pre-existing here, none of them real problems) and on this repo's own
# three documented, intentionally-kept warnings (unrecognized_error_code —
# load-bearing for custom_lint's severity, not dead config; see
# MIGRATION_STATUS.md). Gate on real "error" lines only, not the raw exit
# code, so pre-existing debt doesn't block every future push.
ANALYZE_OUT="$(dart analyze 2>&1)"
echo "$ANALYZE_OUT"
echo "$ANALYZE_OUT" | grep -qE '^\s*error ' && FAILED=1

echo ""
echo -e "${BOLD}dart run custom_lint${RESET}"
dart run custom_lint || FAILED=1

echo ""
echo -e "${BOLD}dart test${RESET}"
dart test --test-randomize-ordering-seed=random || FAILED=1

echo ""
if [[ $FAILED -ne 0 ]]; then
  echo -e "${RED}${BOLD}Push aborted${RESET} — fix the above before pushing."
  exit 1
fi

# Advisory, not a gate: a newly-added check, scoped to lib/ only (see the
# script's own header). False positives here must never block a push —
# only analyze/custom_lint/test do that.
echo -e "${BOLD}Duplicate-literal check (advisory)${RESET}"
# One `dart run` for every file in the scan, not one per file — a fresh
# dart run per file cost ~40s of a ~50s push over lib/'s 110+ files
# (measured). The script itself now loops internally over all given paths.
find lib -name '*.dart' -print0 | xargs -0 dart run tool/check_duplicate_literals.dart

echo ""
echo -e "${BOLD}Test-only symbol census (advisory)${RESET}"
dart run tool/check_test_only_symbols.dart

echo ""
echo -e "${GREEN}${BOLD}All checks passed.${RESET} Pushing..."
echo ""
